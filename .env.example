# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus
# Per model request, in seconds. Background ontology tasks remain visible while
# a slow local model works; choose a bound appropriate to that model.
LLM_TIMEOUT_SECONDS=300
# OASIS/CAMEL simulation and interview requests use this finite deadline too,
# with SDK retries disabled. Limit each model response explicitly.
LLM_SIMULATION_MAX_TOKENS=2048
# Report planning failures remain failures; no replacement outline is invented.
# Bounded outline/section responses use the same LLM_TIMEOUT_SECONDS deadline.
REPORT_PLAN_MAX_TOKENS=1024
REPORT_SECTION_MAX_TOKENS=4096
# Short tool-selection replies before the minimum three evidence calls. Final
# section bodies retain REPORT_SECTION_MAX_TOKENS; tool limit remains five.
REPORT_ACTION_MAX_TOKENS=384
# Bound profile requests to the provider's capacity (use 1 for a single local
# CPU model). AI failures remain failures; rule-based profiles require opt-in.
LLM_MAX_CONCURRENT_REQUESTS=5
PROFILE_PERSONA_CHARACTERS=2000
PROFILE_MAX_TOKENS=4096
# Smaller batches and bounded agent-setting output help CPU inference; incomplete
# or truncated model responses still fail validation instead of using defaults.
SIMULATION_AGENTS_PER_BATCH=15
SIMULATION_AGENT_MAX_TOKENS=4096
# Interactive UI requests use durable commands and short status reads. Expiry
# retains the command for review and does not claim to cancel ongoing inference.
INTERVIEW_COMMAND_TIMEOUT_SECONDS=3600

# Explicit graph selection. Local mode requires the authenticated Graphiti
# worker; configure its URL and private key file through the deployment.
GRAPH_BACKEND=zep_cloud
# Local CPU ingestion may queue multiple real model calls; Cloud retains 600s.
LOCAL_GRAPH_INGESTION_WAIT_TIMEOUT_SECONDS=1800

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
